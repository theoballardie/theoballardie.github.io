{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theoballardie-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "api.theoballardie.com", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://theoballardie.com,https://www.theoballardie.com",
    "NOTIFY_FROM": "pong@theoballardie.com"
  },
  // NOTIFY_TO (where sign-up emails go) is a secret: wrangler secret put NOTIFY_TO
  "d1_databases": [{ "binding": "DB", "database_name": "pong", "database_id": "73d57954-3362-47fb-8016-bc3b0df9851e" }],
  "send_email": [{ "name": "MAILER" }],
  "ratelimits": [
    { "name": "SIGNUPS", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "GAMES", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
